Given an array nums of integers, return how many of them contain an even number of digits.

 solution ==

class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int n = nums.size();
        int count = 0;

        for(int i = 0; i < n; i++) {
            int digits = 0;

            while(nums[i]> 0) {
                nums[i] = nums[i] / 10;
                digits++;
            }

            if(digits % 2 == 0) {
                count++;
            }
        }

        return count;
    }
};
