Given an integer array of size n, find all elements that appear more than ⌊n / 3⌋ times.

solution == 

class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {

        int n = nums.size();
        vector<int> ans;

        for(int i = 0; i < n; i++) {

            // agar current element already check kar chuke hain
            bool alreadyChecked = false;

            for(int x : ans) {
                if(x == nums[i]) {
                    alreadyChecked = true;
                    break;
                }
            }

            if(alreadyChecked) continue;

            int count = 0;

            for(int j = 0; j < n; j++) {
                if(nums[i] == nums[j]) {
                    count++;
                }
            }

            if(count > n/3) {
                ans.push_back(nums[i]);
            }
        }

        return ans;
    }
};
