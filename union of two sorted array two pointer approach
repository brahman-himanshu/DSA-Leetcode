#include <bits/stdc++.h>
using namespace std;

vector<int> findUnion(vector<int>& a1, vector<int>& a2) {

    int i = 0, j = 0;
    vector<int> ans;

    while (i < a1.size() && j < a2.size()) {

        if (a1[i] < a2[j]) {
            if (ans.empty() || ans.back() != a1[i])
                ans.push_back(a1[i]);

            i++;
        }

        else if (a2[j] < a1[i]) {
            if (ans.empty() || ans.back() != a2[j])
                ans.push_back(a2[j]);

            j++;
        }

        else {
            // Both are equal
            if (ans.empty() || ans.back() != a1[i])
                ans.push_back(a1[i]);

            i++;
            j++;
        }
    }

    // Remaining elements of a1
    while (i < a1.size()) {
        if (ans.empty() || ans.back() != a1[i])
            ans.push_back(a1[i]);

        i++;
    }

    // Remaining elements of a2
    while (j < a2.size()) {
        if (ans.empty() || ans.back() != a2[j])
            ans.push_back(a2[j]);

        j++;
    }

    return ans;
}
