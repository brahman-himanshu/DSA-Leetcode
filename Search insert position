class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {

        int start = 0;
        int end = nums.size() - 1;

        while(start <= end) {

            int mid = start + (end - start) / 2;

            // Agar target mil gaya
            if(nums[mid] == target) {
                return mid;
            }

            // Target bada hai
            else if(nums[mid] < target) {
                start = mid + 1;
            }

            // Target chota hai
            else {
                end = mid - 1;
            }
        }

        // Agar target nahi mila
        // to start hi insertion position hogi
        return start;
    }
};
